import { Button } from "../components/button.slint";
import { ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component BottomToolbar inherits Rectangle {
    in-out property <int> selected-tab: -1;
    in-out property <bool> panel-visible: false;

    height: 26px;
    in-out property <length> toolbar-height:
        self.height;
    width: 100%;

    in-out property <[string]> audio-drivers: ["ALSA", "JACK", "ASIO"];
    in-out property <int> audio-driver-index: 0;
    callback audio-driver-changed(string);

    in-out property <[string]> audio-outputs: ["Dispositivo padrão"];
    in-out property <int> audio-output-index: 0;
    callback audio-output-changed(string);

    // Driver and output selector
    HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: CrossAxisAlignment.center;
        height: 100%;
        padding: 4px;

        Text {
            text: "Driver:";
            vertical-alignment: TextVerticalAlignment.center;
            color: Theme.text-dim;
        }

        ComboBox {
            width: 92px;
            height: 18px;
            model: root.audio-drivers;
            current-index: root.audio-driver-index;
            selected(value) => {
                root.audio-driver-changed(value);
            }
        }

        Text {
            text: "Saída:";
            vertical-alignment: TextVerticalAlignment.center;
            color: Theme.text-dim;
        }

        ComboBox {
            width: 210px;
            height: 18px;
            model: root.audio-outputs;
            current-index: root.audio-output-index;
            selected(value) => {
                root.audio-output-changed(value);
            }
        }

        Rectangle { horizontal-stretch: 1; }
    }

    // Tab bar
    HorizontalLayout {
        spacing: 6px;
        alignment: LayoutAlignment.center;
        cross-axis-alignment: CrossAxisAlignment.center;
        height: 100%;
        padding: 5px;

        // Tab: Sampler
        Button {
            text: "Sampler";
            corner-radius: 2px;
            height: 15px;
            toggled: root.selected-tab == 1 && root.panel-visible;
            toggled-bg: Theme.accent;
            clicked => {
                if root.selected-tab == 1 && root.panel-visible {
                    root.panel-visible = false;
                    root.selected-tab = -1;
                } else {
                    root.selected-tab = 1;
                    root.panel-visible = true;
                }
            }
        }

         // Tab: TimeWarp
        Button {
            text: "TimeWarp";
            corner-radius: 2px;
            height: 15px;
            toggled: root.selected-tab == 4 && !root.panel-visible;
            toggled-bg: Theme.accent;
            clicked => {
                if root.selected-tab == 4 && !root.panel-visible {
                    root.panel-visible = false;
                    root.selected-tab = -1;
                } else {
                    root.selected-tab = 4;
                    root.panel-visible = false;
                }
            }
        }

        // Tab: Piano Roll
        Button {
            text: "Piano Roll";
            corner-radius: 2px;
            height: 15px;
            toggled: root.selected-tab == 2 && !root.panel-visible;
            toggled-bg: Theme.accent;
            clicked => {
                if root.selected-tab == 2 && !root.panel-visible {
                    root.panel-visible = false;
                    root.selected-tab = -1;
                } else {
                    root.selected-tab = 2;
                    root.panel-visible = false;
                }
            }
        }

        // Tab: Mixer
        Button {
            text: "Mixer";
            corner-radius: 2px;
            height: 15px;
            toggled: root.selected-tab == 0 && root.panel-visible;
            toggled-bg: Theme.accent;
            clicked => {
                if root.selected-tab == 0 && root.panel-visible {
                    root.panel-visible = false;
                    root.selected-tab = -1;
                } else {
                    root.selected-tab = 0;
                    root.panel-visible = true;
                }
            }
        }

         // Tab: AI Assistant
        Button {
            text: "AI Assistant";
            corner-radius: 2px;
            height: 15px;
            toggled: root.selected-tab == 3 && root.panel-visible;
            toggled-bg: Theme.accent;
            clicked => {
                if root.selected-tab == 3 && root.panel-visible {
                    root.panel-visible = false;
                    root.selected-tab = -1;
                } else {
                    root.selected-tab = 3;
                    root.panel-visible = true;
                }
            }
        }
    }
}