import { Theme } from "../theme.slint";

export component StereoMeter inherits Rectangle {
    in property <float> left-level: 0.0;
    in property <float> right-level: 0.0;
    in property <float> left-peak: 0.0;
    in property <float> right-peak: 0.0;
    /// RMS já normalizado 0..1 (não é amplitude linear).
    in property <float> left-rms: 0.0;
    in property <float> right-rms: 0.0;
    in property <bool> left-clipped: false;
    in property <bool> right-clipped: false;

    in property <length> meter-width: 5px;
    in property <length> channel-gap: 6px;
    in property <color> meter-background: #B8B8B8;
    in property <color> meter-border: transparent;
    in property <bool> signal-fill-only: false;

    // Duas leituras na mesma coluna, ambas em degradê:
    // - verde-limão: envelope de nível (a barra principal);
    // - vermelho: luz de clip no topo.
    private property <brush> level-color:
        @linear-gradient(0deg, #3FAE00 0%, #B4FF1A 100%);
    private property <brush> clip-color:
        @linear-gradient(0deg, #C62828 0%, #FF5252 100%);

    private property <length> meter-height: Math.max(1px, root.height);
    private property <length> channel-width: Math.max(2px, root.meter-width);
    private property <length> divider-width: 1px;

    width: root.channel-width * 2 + root.channel-gap + root.divider-width;
 

    function level-clamped(value: float) -> float {
        if value != value { return 0.0; }
        return Math.max(0.0, Math.min(1.0, value));
    }

    HorizontalLayout {
        x: 0; y: 0; width: parent.width; height: parent.height;
        alignment: center;
        cross-axis-alignment: CrossAxisAlignment.center;
        spacing: root.channel-gap / 2;

        // CANAL L
        Rectangle {
            width: root.channel-width; height: root.meter-height;
            background: root.meter-background;
            border-color: root.meter-border;
            clip: true;

            // Barra principal: envelope de nível.
            Rectangle {
                x: 0px;
                y: parent.height * (1.0 - root.level-clamped(root.left-level));
                width: parent.width;
                height: parent.height * root.level-clamped(root.left-level);
                background: root.level-color;
                clip: true;
            }

            // Luz de clip: latch até o clique no medidor.
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 3px;
                background: root.clip-color;
                visible: root.left-clipped;
            }
        }

        Rectangle {
            width: root.divider-width; height: root.meter-height;
            background: #000000;
        }
        // CANAL R
        Rectangle {
            width: root.channel-width; height: root.meter-height;
            background: root.meter-background;
            border-color: root.meter-border;
            clip: true;

            // Barra principal: envelope de nível.
            Rectangle {
                x: 0px;
                y: parent.height * (1.0 - root.level-clamped(root.right-level));
                width: parent.width;
                height: parent.height * root.level-clamped(root.right-level);
                background: root.level-color;
                clip: true;
            }

            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 3px;
                background: root.clip-color;
                visible: root.right-clipped;
            }
        }
    }
}
