import { Theme } from "../theme.slint";

export component DonationDialog inherits Rectangle {

    in-out property <bool> open: true;
    callback closed();

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop com cor sólida escura (sem blur real no Slint, usamos alpha)
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0A080F.with-alpha(0.80);
        z: 100;

        TouchArea {
            clicked => {
                root.open = false;
                root.closed();
            }
        }
    }

    // Card principal com vidro (glassmorphism simulado)
    if root.open: Rectangle {
        x: (parent.width - 520px) / 2;
        y: (parent.height - 620px) / 2;
        width: 520px;
        height: 620px;
        z: 101;
        border-radius: 30px;
        clip: true;

        // Sombra simulada com múltiplas camadas
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 30px;
            background: #16141E.with-alpha(0.95);
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.45);

            // Brilho interno superior
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 2px;
                background: Theme.accent.with-alpha(0.6);
            }
        }

        // Gradiente decorativo no canto superior direito
        Rectangle {
            x: parent.width - 120px;
            y: parent.height - 120px;
            width: 200px;
            height: 200px;
            border-radius: 100px;
            background: Theme.accent.with-alpha(0.15);
            z: -1;
        }

        // ============================================
        // CABEÇALHO
        // ============================================

        Rectangle {
            x: 32px;
            y: 32px;
            width: parent.width - 64px;
            height: 120px;

            // Ícone grande (coração estilizado com texto)
            Rectangle {
                x: 0px;
                y: 0px;
                width: 64px;
                height: 64px;
                border-radius: 20px;
                background: Theme.accent.with-alpha(0.2);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.4);

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "❤️";
                    font-size: 32px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                x: 78px;
                y: 10px;
                width: parent.width - 78px;
                text: "Apoie o Ruana Studio";
                color: Theme.text-primary;
                font-size: 22px;
                font-weight: 700;
            }

            Text {
                x: 78px;
                y: 42px;
                width: parent.width - 78px;
                height: 56px;
                text: "Mantenha o projeto livre, aberto e sem anúncios.\nSua doação paga hospedagem e desenvolvimento.";
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        // ============================================
        // SEÇÕES DE DOAÇÃO
        // ============================================

        VerticalLayout {
            x: 32px;
            y: 170px;
            width: parent.width - 64px;
            spacing: 16px;

            // ---------- WhatsApp ----------
            Rectangle {
                width: parent.width;
                height: 96px;
                border-radius: 16px;
                background: Theme.surface.with-alpha(0.5);
                border-width: 1px;
                border-color: Theme.border.with-alpha(0.3);

                HorizontalLayout {
                    spacing: 16px;
                    padding-left: 20px;
                    padding-right: 16px;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    height: 100%;

                    // Ícone
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 14px;
                        background: #25D366;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "💬";
                            font-size: 26px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Texto
                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: "WhatsApp";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        Text {
                            text: "55 11 98252-9036";
                            color: #25D366;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // Botão
                    Rectangle {
                        width: 120px;
                        height: 40px;
                        border-radius: 10px;
                        background: #25D366.with-alpha(0.15);
                        border-width: 1px;
                        border-color: #25D366.with-alpha(0.5);

                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                        }

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Abrir";
                            color: #25D366;
                            font-size: 11px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            z: 1;
                        }
                    }
                }
            }

            // ---------- Pix ----------
            Rectangle {
                width: parent.width;
                height: 96px;
                border-radius: 16px;
                background: Theme.surface.with-alpha(0.5);
                border-width: 1px;
                border-color: Theme.border.with-alpha(0.3);

                HorizontalLayout {
                    spacing: 16px;
                    padding-left: 20px;
                    padding-right: 16px;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    height: 100%;

                    // Ícone
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 14px;
                        background: Theme.accent.with-alpha(0.15);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.4);

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "🔑";
                            font-size: 26px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Texto
                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: "Pix";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        Text {
                            text: "ruana@studio.com";
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // Botão
                    Rectangle {
                        width: 120px;
                        height: 40px;
                        border-radius: 10px;
                        background: Theme.accent.with-alpha(0.15);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.5);

                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                        }

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Copiar";
                            color: Theme.accent;
                            font-size: 11px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            z: 1;
                        }
                    }
                }
            }

            // ---------- PayPal ----------
            Rectangle {
                width: parent.width;
                height: 96px;
                border-radius: 16px;
                background: Theme.surface.with-alpha(0.25);
                border-width: 1px;
                border-color: Theme.border.with-alpha(0.2);
                opacity: 0.6;

                HorizontalLayout {
                    spacing: 16px;
                    padding-left: 20px;
                    padding-right: 16px;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    height: 100%;

                    // Ícone
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 14px;
                        background: Theme.text-dim.with-alpha(0.2);

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "🅿️";
                            font-size: 26px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Texto
                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: "PayPal";
                            color: Theme.text-primary.transparentize(0.3);
                            font-size: 14px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Em breve";
                            color: Theme.text-dim.transparentize(0.3);
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // Botão desabilitado
                    Rectangle {
                        width: 120px;
                        height: 40px;
                        border-radius: 10px;
                        background: Theme.text-dim.with-alpha(0.1);

                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            enabled: false;
                        }

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Em breve";
                            color: Theme.text-dim.transparentize(0.4);
                            font-size: 11px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            z: 1;
                        }
                    }
                }
            }

            // ---------- Rodapé ----------
            Rectangle {
                width: parent.width;
                height: 56px;
                border-radius: 14px;
                background: Theme.surface.with-alpha(0.3);
                border-width: 1px;
                border-color: Theme.border.with-alpha(0.2);

                HorizontalLayout {
                    spacing: 12px;
                    padding-left: 20px;
                    padding-right: 16px;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    height: 100%;

                    Text {
                        text: "✨";
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Obrigado por apoiar o Ruana Studio!";
                        color: Theme.text-dim;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "v0.6.0";
                        color: Theme.accent.with-alpha(0.6);
                        font-size: 10px;
                        font-weight: 700;
                    }
                }
            }
        }

        // ============================================
        // BOTÃO FECHAR (canto superior direito)
        // ============================================

        Rectangle {
            x: parent.width - 52px;
            y: 28px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: Theme.surface.with-alpha(0.6);
            border-width: 1px;
            border-color: Theme.border.with-alpha(0.3);

            TouchArea {
                width: parent.width;
                height: parent.height;

                clicked => {
                    root.open = false;
                    root.closed();
                }
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: "✕";
                color: Theme.text-dim;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                z: 1;
            }
        }
    }
}
