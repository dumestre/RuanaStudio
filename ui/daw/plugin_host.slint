import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";

export component PluginHostWindow inherits Rectangle {
    in property <string> plugin-name: "Plugin";
    in property <string> format: "VST3";
    in-out property <bool> enabled: true;
    in-out property <bool> bypassed: false;

    callback toggle-enabled();
    callback toggle-bypass();

    width: 640px;
    height: 420px;
    background: Theme.base;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        cross-axis-alignment: CrossAxisAlignment.stretch;
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            width: 100%;
            cross-axis-alignment: CrossAxisAlignment.center;
            height: 20px;
            

            Text {
                text: root.plugin-name + " (" + root.format + ")";
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 500;
                height: 100%;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            HorizontalLayout {
                cross-axis-alignment: CrossAxisAlignment.center;

                Button {
                    icon: @image-url("../icons/power.svg");
                    icon-color: root.enabled ? Theme.accent : Theme.text-dim;
                    keep-icon-color: true;
                    resting-bg: Theme.surface-high;
                    hover-bg: Theme.surface;
                    corner-radius: 12px;
                    borderless: true;
                    padding-x: 8px;
                    clicked => { root.toggle-enabled(); }
                }

                Button {
                    icon: @image-url("../icons/lucide_thumbs_up.svg");
                    filled-icon: @image-url("../icons/lucide_thumbs_down_filled.svg");
                    toggled: root.bypassed;
                    icon-color: root.bypassed ? Theme.danger : Theme.accent;
                    keep-icon-color: true;
                    resting-bg: Theme.surface-high;
                    hover-bg: Theme.surface;
                    corner-radius: 12px;
                    borderless: true;
                    padding-x: 8px;
                    clicked => { root.toggle-bypass(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            width: 100%;
            background: Theme.surface;
            border-radius: 4px;

            Text {
                text: "Area de edicao do plugin (host wgpu)";
                color: Theme.text-dim;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}