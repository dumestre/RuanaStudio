import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";

export component PluginHostWindow inherits Rectangle {
    in property <string> plugin-name: "Plugin";
    in property <string> format: "VST3";
    in-out property <bool> enabled: true;
    in-out property <bool> bypassed: false;

    callback toggle-enabled();
    callback toggle-bypass();

    width: 640px;
    height: 420px;
    background: Theme.base;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.plugin-name + " (" + root.format + ")";
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Button {
                icon: @image-url("../icons/power.svg");
                icon-color: root.enabled ? Theme.accent : Theme.text-dim;
                keep-icon-color: true;
                min-height: 20px;
                preferred-width: 20px;
                preferred-height: 20px;
                clicked => { root.toggle-enabled(); }
            }

            

            Button {
                border-radius: 32px;
                corner-radius: 0px;
                icon: @image-url("../icons/power.svg");
                icon-color: root.bypassed ? Theme.danger : Theme.text-dim;
                keep-icon-color: true;
                preferred-width: 20px;
                preferred-height: 20px;
                clicked => { root.toggle-bypass(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            border-radius: 4px;

            Text {
                text: "Area de edicao do plugin (host wgpu)";
                color: Theme.text-dim;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
