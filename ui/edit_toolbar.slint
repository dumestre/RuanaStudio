
import { Button } from "components/button.slint";
import { Theme } from "theme.slint";

export component EditToolbar inherits Rectangle {

    // ============================================================
    // ESTADO
    // ============================================================

    in-out property <int> active-tool: 0;

    in-out property <bool> clip-pool-open: false;
    in-out property <bool> beat-open: false;
    in-out property <bool> explorer-visible: true;
    in-out property <bool> panel-visible: true;

    callback tool-changed(int);

    // ============================================================
    // DIMENSÕES
    // ============================================================

    height: 20px;

    // ============================================================
    // CORES DOS BOTÕES
    // ============================================================

    // Estado normal
    // Fundo cinza escuro e ícone cinza claro.
    // Estado selecionado
    // Fundo vermelho e ícone branco.

    // ============================================================
    // TOOLBAR
    // ============================================================

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        cross-axis-alignment: CrossAxisAlignment.center;
        padding-left: 4px;
        padding-right: 4px;

        HorizontalLayout {
            spacing: 2px;
            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;
            horizontal-stretch: 1;

            // =================================================
            // SELECT - 0
            // =================================================

            Button {
                width: 18px;
                height: 18px;

                resting-bg: #2D2D2D;

                icon: @image-url("icons/select.svg");
                filled-icon: @image-url("icons/select_filled.svg");

                icon-color: #BDBDBD;

                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                padding-x: 0px;
                borderless: true;
                corner-radius: 2px;

                toggled: root.active-tool == 0;

                toggled-fg: #FFFFFF;
                toggled-bg: #91ff00b2;
                toggled-icon-color: #FFFFFF;

                clicked => {
                    root.active-tool = 0;
                    root.tool-changed(0);
                }
            }

            // =================================================
            // DRAW - 4
            // =================================================

            Button {
                width: 18px;
                height: 18px;

                resting-bg: #2D2D2D;

                icon: @image-url("icons/draw.svg");
                filled-icon: @image-url("icons/draw_filled.svg");

                icon-color: #BDBDBD;

                borderless: true;
                corner-radius: 2px;

                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                toggled: root.active-tool == 4;

                toggled-fg: #FFFFFF;
                toggled-bg: #91ff00b2;
                toggled-icon-color: #FFFFFF;

                clicked => {
                    root.active-tool = 4;
                    root.tool-changed(4);
                }
            }

            // =================================================
            // SLICE - 1
            // =================================================

            Button {
                width: 18px;
                height: 18px;

                resting-bg: #2D2D2D;

                icon: @image-url("icons/slice.svg");
                filled-icon: @image-url("icons/slice_filled.svg");

                icon-color: #BDBDBD;

                borderless: true;
                corner-radius: 2px;

                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                toggled: root.active-tool == 1;

                toggled-fg: #FFFFFF;
                toggled-bg: #91ff00b2;
                toggled-icon-color: #FFFFFF;

                clicked => {
                    root.active-tool = 1;
                    root.tool-changed(1);
                }
            }

            // =================================================
            // GLUE - 2
            // =================================================

            Button {
                width: 18px;
                height: 18px;

                resting-bg: #2D2D2D;

                icon: @image-url("icons/glue.svg");
                filled-icon: @image-url("icons/glue_filled.svg");

                icon-color: #BDBDBD;

                borderless: true;
                corner-radius: 2px;

                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                toggled: root.active-tool == 2;

                toggled-fg: #FFFFFF;
                toggled-bg: #91ff00b2;
                toggled-icon-color: #FFFFFF;

                clicked => {
                    root.active-tool = 2;
                    root.tool-changed(2);
                }
            }

            // =================================================
            // STRETCH - 3
            // =================================================

            Button {
                width: 18px;
                height: 18px;

                resting-bg: #2D2D2D;

                icon: @image-url("icons/expand_diag.svg");
                filled-icon: @image-url("icons/stretch_filled.svg");

                icon-color: #BDBDBD;

                borderless: true;
                corner-radius: 2px;

                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                toggled: root.active-tool == 3;

                toggled-fg: #FFFFFF;
                toggled-bg: #91ff00b2;
                toggled-icon-color: #FFFFFF;

                clicked => {
                    root.active-tool = 3;
                    root.tool-changed(3);
                }
            }

            // =================================================
            // ERASE - 5
            // =================================================

            Button {
                width: 18px;
                height: 18px;

                resting-bg: #2D2D2D;

                icon: @image-url("icons/erase.svg");
                filled-icon: @image-url("icons/erase_filled.svg");

                icon-color: #BDBDBD;

                borderless: true;
                corner-radius: 2px;

                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                toggled: root.active-tool == 5;

                toggled-fg: #FFFFFF;
                toggled-bg: #91ff00b2;
                toggled-icon-color: #FFFFFF;

                clicked => {
                    root.active-tool = 5;
                    root.tool-changed(5);
                }
            }
        }
    }
}
