import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";
import { InsertStyle } from "insert_style.slint";

// Slot de insert (efeito encadeado) de um canal do mixer.
// Mostra o número do slot, o nome do processador e botões de
// power (bypass) e remover.
export component InsertSlot inherits Rectangle {
    in property <int> slot-index: 0;
    in property <string> name: "";
    in property <bool> enabled: true;
    in property <bool> compact: false;

    // Feedback do arrasto: o slot que está sendo arrastado e o alvo provisório.
    in property <bool> dragging: false;
    in property <bool> drop-target: false;

    callback toggle();
    callback remove();

    // Reordenar por arrasto. A origem e o número de linhas percorridas são
    // resolvidos no `MixerChannel`, que conhece a lista inteira.
    callback drag-start(int);
    callback drag-move(int, int);
    callback drag-drop(int, int);

    // Renomear: double-click no nome abre o campo inline.
    callback rename(int, string);
    private property <bool> editing: false;
    private property <string> draft: "";

    private property <length> press-y: 0px;
    private property <bool> drag-active: false;

    height: InsertStyle.slot-h(root.compact);
    background: root.dragging
        ? InsertStyle.slot-bg-dragging
        : InsertStyle.slot-bg;
    border-radius: 3px;
    border-width: 1px;
    border-color: (root.dragging || root.drop-target)
        ? InsertStyle.slot-border-active
        : InsertStyle.slot-border;

    states [
        disabled when !root.enabled: {
            opacity: 0.55;
        }
        hovered when ta.has-hover && !root.editing: {
            border-color: InsertStyle.slot-border-active;
            background: InsertStyle.slot-bg.with-alpha(0.15);
        }
    ]

    // Número do slot
    Text {
        x: 6px;
        width: 16px;
        height: 100%;
        color: InsertStyle.slot-number-color;
        font-size: InsertStyle.slot-number-size(root.compact);
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
        text: (root.slot-index + 1);
    }

    // Nome do processador
    if !root.editing: Text {
        x: 22px;
        width: parent.width - InsertStyle.icon-area-w(root.compact) - 26px;
        height: 100%;
        color: root.name == "" ? InsertStyle.slot-number-color : InsertStyle.slot-name-color;
        font-size: InsertStyle.slot-name-size(root.compact);
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: TextOverflow.elide;
        text: root.name == "" ? "Vazio" : root.name;
    }

    // Arrastar pelo número/nome reordena. Double-click entra no rename inline.
    ta := TouchArea {
        x: 0;
        width: parent.width - InsertStyle.icon-area-w(root.compact);
        height: 100%;
        mouse-cursor: move;

        double-clicked => {
            if root.name != "" {
                root.draft = root.name;
                root.editing = true;
            }
        }

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-y = self.mouse-y;
                root.drag-active = true;
                root.drag-start(root.slot-index);
            } else if (ev.kind == PointerEventKind.move) {
                if (root.drag-active) {
                    root.drag-move(
                        root.slot-index,
                        Math.round((self.mouse-y - root.press-y) / 1px / 24)
                    );
                }
            } else {
                if (root.drag-active) {
                    root.drag-active = false;
                    root.drag-drop(
                        root.slot-index,
                        Math.round((self.mouse-y - root.press-y) / 1px / 24)
                    );
                }
            }
        }
    }

    // Campo de edição do nome (por cima do drag-area, só quando editando).
    if root.editing: TextInput {
        x: 22px;
        width: parent.width - InsertStyle.icon-area-w(root.compact) - 26px;
        height: 100%;
        text <=> root.draft;
        color: Theme.text-primary;
        font-size: InsertStyle.slot-name-size(root.compact);
        vertical-alignment: center;
        selection-background-color: Theme.accent;

        init => { self.focus(); }

        accepted => {
            root.rename(root.slot-index, root.draft);
            root.editing = false;
        }

        changed has-focus => {
            if (!self.has-focus && root.editing) {
                root.rename(root.slot-index, root.draft);
                root.editing = false;
            }
        }
    }

    // Power (bypass)
    Button {
        width: InsertStyle.power-w(root.compact);
        height: InsertStyle.power-h(root.compact);
        x: parent.width - InsertStyle.icon-area-w(root.compact) + 2px;
        y: (parent.height - self.height) / 2;
        icon: @image-url("../icons/power.svg");
        icon-size: InsertStyle.power-icon-size(root.compact);
        borderless: true;
        icon-color: root.enabled ? Theme.ok : Theme.text-dim;
        keep-icon-color: true;
        resting-bg: InsertStyle.slot-bg;
        hover-bg: InsertStyle.slot-bg.with-alpha(0.3);
        clicked => { root.toggle(); }
    }

    // Remover
    Button {
        width: InsertStyle.remove-w(root.compact);
        height: InsertStyle.remove-h(root.compact);
        x: parent.width - InsertStyle.remove-w(root.compact) - 4px;
        y: (parent.height - self.height) / 2;
        icon: @image-url("../icons/close.svg");
        icon-size: InsertStyle.remove-icon-size(root.compact);
        borderless: true;
        icon-color: Theme.text-dim;
        resting-bg: InsertStyle.slot-bg;
        hover-bg: Theme.danger.with-alpha(0.15);
        clicked => { root.remove(); }
    }
}
