import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";

// Slot de insert (efeito encadeado) de um canal do mixer.
// Mostra o número do slot, o nome do processador e botões de
// power (bypass) e remover.
export component InsertSlot inherits Rectangle {
    in property <int> slot-index: 0;
    in property <string> name: "";
    in property <bool> enabled: true;

    // Feedback do arrasto: o slot que está sendo arrastado e o alvo provisório.
    in property <bool> dragging: false;
    in property <bool> drop-target: false;

    callback toggle();
    callback remove();

    // Reordenar por arrasto. A origem e o número de linhas percorridas são
    // resolvidos no `MixerChannel`, que conhece a lista inteira.
    callback drag-start(int);
    callback drag-move(int, int);
    callback drag-drop(int, int);

    // Renomear: double-click no nome abre o campo inline.
    callback rename(int, string);
    private property <bool> editing: false;
    private property <string> draft: "";

    // Altura de um slot + espaçamento da lista (20px + 2px): converte o
    // deslocamento em pixels no número de posições percorridas.
    private property <length> press-y: 0px;
    private property <bool> drag-active: false;

    height: 20px;
    background: root.dragging ? Theme.surface-high : Theme.base;
    border-radius: 3px;
    border-width: 1px;
    border-color: (root.dragging || root.drop-target) ? Theme.accent : Theme.border;

    states [
        disabled when !root.enabled: {
            opacity: 0.55;
        }
    ]

    // Número do slot
    Text {
        x: 5px;
        width: 14px;
        height: 100%;
        color: Theme.text-dim;
        font-size: 8px;
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
        text: (root.slot-index + 1);
    }

    // Nome do processador
    if !root.editing: Text {
        x: 19px;
        width: parent.width - 51px;
        height: 100%;
        color: Theme.text-primary;
        font-size: 9px;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: TextOverflow.elide;
        text: root.name;
    }

    // Arrastar pelo número/nome reordena. A faixa da direita (34px) fica de
    // fora para não roubar o clique do power nem do remover. Double-click
    // entra no rename inline.
    drag-area := TouchArea {
        x: 0;
        width: parent.width - 34px;
        height: 100%;
        mouse-cursor: move;

        double-clicked => {
            root.draft = root.name;
            root.editing = true;
        }

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-y = self.mouse-y;
                root.drag-active = true;
                root.drag-start(root.slot-index);
            } else if (ev.kind == PointerEventKind.move) {
                if (root.drag-active) {
                    root.drag-move(
                        root.slot-index,
                        Math.round((self.mouse-y - root.press-y) / 1px / 22)
                    );
                }
            } else {
                if (root.drag-active) {
                    root.drag-active = false;
                    root.drag-drop(
                        root.slot-index,
                        Math.round((self.mouse-y - root.press-y) / 1px / 22)
                    );
                }
            }
        }
    }

    // Campo de edição do nome (por cima do drag-area, só quando editando).
    if root.editing: TextInput {
        x: 19px;
        width: parent.width - 51px;
        height: 100%;
        text <=> root.draft;
        color: Theme.text-primary;
        font-size: 9px;
        vertical-alignment: center;
        selection-background-color: Theme.accent;

        init => { self.focus(); }

        accepted => {
            root.rename(root.slot-index, root.draft);
            root.editing = false;
        }

        changed has-focus => {
            if (!self.has-focus && root.editing) {
                root.rename(root.slot-index, root.draft);
                root.editing = false;
            }
        }
    }

    // Power (bypass)
    Button {
        width: 14px;
        height: 14px;
        x: parent.width - 30px;
        y: (parent.height - self.height) / 2;
        icon: @image-url("../icons/power.svg");
        icon-size: 10px;
        borderless: true;
        icon-color: root.enabled ? Theme.ok : Theme.text-dim;
        keep-icon-color: true;
        clicked => { root.toggle(); }
    }

    // Remover
    Button {
        width: 12px;
        height: 14px;
        x: parent.width - 16px;
        y: (parent.height - self.height) / 2;
        icon: @image-url("../icons/close.svg");
        icon-size: 9px;
        borderless: true;
        icon-color: Theme.text-dim;
        clicked => { root.remove(); }
    }
}
