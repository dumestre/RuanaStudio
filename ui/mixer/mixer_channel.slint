import { Theme } from "../theme.slint";
import { MixerStyle } from "mixer_style.slint";
import { ClipPalette } from "../clip_palette.slint";
import { Button } from "../components/button.slint";
import { PanControl } from "pan_control.slint";
import { Meter } from "../components/meter.slint";
import { InsertSlot } from "insert_slot.slint";
import { SectionHeader } from "section_header.slint";
import { AudioScale } from "../components/audio_scale.slint";
import { ScrollView } from "std-widgets.slint";

export component MixerChannel inherits Rectangle {

    // ==========================================
    // IDENTIDADE
    // ==========================================

    in property <string> name: "";
    in property <color> channel-color: Theme.accent;
    in property <bool> is-master: false;
    in property <int> channel-index: 0;
    in property <bool> selected: false;
    callback select-requested(int);

    /// Largura da faixa (narrow/wide), controlada pelo `Mixer`.
    in property <length> strip-width: 100px;

    /// Índice de cor da trilha na paleta (0 = padrão).
    in property <int> color-index: 0;
    /// Nova cor escolhida no popup (índice da paleta).
    callback color-picked(int);

    // Popup de paleta aberto pelo botão direito no cabeçalho.
    private property <bool> color-picker-open: false;

    in property <length> available-height: 200px;

    /// Densidade: compact em telas estreitas, wide em notebook+.
    in property <bool> compact: false;

    // ==========================================
    // ESTADO
    // ==========================================

    in property <bool> muted: false;
    in property <bool> soloed: false;
    in property <bool> arm: false;

    // Mudado para 'in-out' para podermos alterar visualmente ao arrastar!
    in-out property <float> volume: 0.8;
    
    in-out property <float> pan: 0.5;

    // Medição real, em dB normalizado (0..1). Quem popula é o
    // `MeterPump` a partir do pico que a engine publica — não existe
    // mais VU simulado.
    in property <float> left-level: 0.0;
    in property <float> right-level: 0.0;
    in property <float> left-peak: 0.0;
    in property <float> right-peak: 0.0;
    in property <float> left-rms: 0.0;
    in property <float> right-rms: 0.0;
    in property <bool> left-clipped: false;
    in property <bool> right-clipped: false;

    // ==========================================
    // INSERTS
    // ==========================================

    in property <int> max-slot-count: 8;
    min-height: 140px;
    in property <int> insert-count: 0;
    in property <[string]> insert-names: [];
    in property <[bool]> insert-enabled: [];

    // ==========================================
    // SEÇÕES COLAPSÁVEIS
    //
    // O estado é do `Mixer` (global para todas as faixas, como num mixer
    // de verdade): o usuário não quer abrir insert por insert.
    // `inserts-visible` ainda exige altura mínima — painel baixo esmaga o
    // bloco de fader/meter se os inserts insistirem em aparecer.
    // ==========================================

    in-out property <bool> show-inserts: true;
    in-out property <bool> show-pan: true;

    // ==========================================
    // CALLBACKS
    // ==========================================

    callback param-changed(int, string, float);

    callback insert-add();
    callback insert-remove(int);
    callback insert-toggle(int);
    /// Move um insert dentro da cadeia (arrastar para reordenar).
    callback insert-move(int, int);
    /// Renomeia um insert (double-click no nome).
    callback insert-rename(int, string);
    /// Renomeia o canal (double-click no cabeçalho).
    callback rename(string);

    // Edição inline do nome do canal.
    private property <bool> editing-name: false;
    private property <string> draft-name: "";

    // Origem e alvo provisório do arrasto (-1 = nenhum).
    private property <int> drag-from: -1;
    private property <int> drag-to: -1;

    // Clique na luz de clip: apaga o latch daquele canal.
    callback clear-clip(int);

    // ==========================================
    // DISPLAY
    // ==========================================


    // O LCD passa a ler a curva oficial em vez de repetir a fórmula
    // `-60 + pos*60` aqui. As duas versões divergiram uma vez e o
    // medidor passou a discordar do número ao lado.
    //
    // O fundo é silêncio DE VERDADE (ver `AudioScale.fader-pos-to-
    // linear`), então "-60.0 dB" mentiria ali: o ganho é zero. O piso
    // da escala é onde a barra para de descer, não onde a faixa cala.
    property <string> vol-display:
        AudioScale.fader-pos-to-db(root.volume).to-fixed(1);

    // ==========================================
    // CHANNEL
    // ==========================================

    width: root.strip-width;
    background: Theme.surface;

    // Seleciona ao clicar em áreas livres; o editor de dB, em z superior,
    // encaminha seus próprios cliques para o campo de texto.
    TouchArea {
        x: 0px;
        y: 0px;
        mouse-cursor: pointer;
        clicked => { root.select-requested(root.channel-index); }
        z: -1;
    }

    // ==========================================
    // DIVISÓRIA
    // ==========================================

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: MixerStyle.strip-h(root.compact);
        background: root.channel-color;

        if root.editing-name: TextInput {
            text <=> root.draft-name;
            color: #17191d;
            font-size: MixerStyle.name-size(root.compact);
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;

            selection-background-color: Theme.accent;
            selection-foreground-color: #17191d;

            init => { self.focus(); }

            accepted => {
                root.rename(root.draft-name);
                root.editing-name = false;
            }

            // Clicar fora / trocar de foco também confirma.
            changed has-focus => {
                if (!self.has-focus && root.editing-name) {
                    root.rename(root.draft-name);
                    root.editing-name = false;
                }
            }
        }

        if !root.editing-name: Text {
            text: root.name;
            color: #17191d;
            font-size: MixerStyle.name-size(root.compact);
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
            overflow: elide;
        }

        // Double-click no nome entra em edição (a master não renomeia: o
        // nome dela é fixo). Botão direito abre a paleta de cor.
        TouchArea {
            enabled: !root.is-master;
            mouse-cursor: text;
            double-clicked => {
                root.draft-name = root.name;
                root.editing-name = true;
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down
                    && ev.button == PointerEventButton.right) {
                    root.color-picker-open = !root.color-picker-open;
                }
            }
        }
    }

    // Paleta de cor do canal: 20 swatches (2 × 10) de `ClipPalette`.
    // Sincronizada com a trilha: escolher aqui muda `track.color`, que é a
    // mesma fonte do cabeçalho da timeline.
    if root.color-picker-open && !root.is-master: Rectangle {
        x: 2px;
        y: MixerStyle.strip-h(root.compact);
        width: parent.width - 4px;
        height: 43px;
        background: Theme.surface-high;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.border;
        z: 50;

        VerticalLayout {
            padding: 3px;
            spacing: 2px;

            HorizontalLayout {
                spacing: 2px;
                for c[idx] in ClipPalette.top: Rectangle {
                    horizontal-stretch: 1;
                    height: 16px;
                    border-radius: 2px;
                    background: ClipPalette.colors[idx];
                    border-width: root.color-index == idx ? 2px : 0px;
                    border-color: Theme.text-primary;

                    TouchArea {
                        clicked => {
                            root.color-picked(idx);
                            root.color-picker-open = false;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 2px;
                for c[idx] in ClipPalette.bottom: Rectangle {
                    horizontal-stretch: 1;
                    height: 16px;
                    border-radius: 2px;
                    background: ClipPalette.colors[idx + 10];
                    border-width: root.color-index == idx + 10 ? 2px : 0px;
                    border-color: Theme.text-primary;

                    TouchArea {
                        clicked => {
                            root.color-picked(idx + 10);
                            root.color-picker-open = false;
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
        z: 2;
    }

    Rectangle {
        x: 0px;
        y: MixerStyle.strip-h(root.compact);
        width: parent.width - 1px;
        height: parent.height - MixerStyle.strip-h(root.compact);
        border-width: root.selected ? 1px : 0px;
        border-color: root.channel-color;
        z: 1;
    }

    // ==========================================
    // CHANNEL STRIP
    // ==========================================

    VerticalLayout {
        padding: MixerStyle.pad(root.compact);
        spacing: MixerStyle.gap(root.compact);
        vertical-stretch: 1;
        width: 100%;

        cross-axis-alignment: CrossAxisAlignment.center;

        // ======================================
        // HEADER
        // ======================================

        Rectangle {
            height: MixerStyle.strip-h(root.compact);
            width: 100%;

        }

        // ======================================
        // MUTE / SOLO / RECORD
        // ======================================

        HorizontalLayout {
            height: MixerStyle.btn-h(root.compact);

            spacing: MixerStyle.gap(root.compact);
            width: 100%;

            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;

            // MUTE
            Button {
                width: MixerStyle.btn-w(root.compact);
                height: MixerStyle.btn-h(root.compact);
                // Botão em repouso é SEMPRE `surface-high` — o mesmo
                // descanso da toolbar e da edit_toolbar. Era `base`,
                // que é o POÇO: deixava o botão mais escuro que o
                // painel que o contém (um degrau para trás).
                resting-bg: Theme.surface-high;
                corner-radius: 2px;
                
                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                text: "M";

                toggled: root.muted;
                // Era `surface` — idêntico ao fundo do canal, então
                // o mute ligado não mudava nada na tela.
                toggled-bg: Theme.accent;

                clicked => {
                    root.param-changed(
                        root.channel-index,
                        "muted",
                        root.muted ? 0.0 : 1.0
                    );
                }
            }

            // SOLO
            if !root.is-master: Button {
                width: MixerStyle.btn-w(root.compact);
                height: MixerStyle.btn-h(root.compact);
                resting-bg: Theme.surface-high;
                corner-radius: 2px;
                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                text: "S";

                toggled: root.soloed;
                toggled-bg: Theme.accent;

                clicked => {
                    root.param-changed(
                        root.channel-index,
                        "soloed",
                        root.soloed ? 0.0 : 1.0
                    );
                }
            }

            // RECORD
            if !root.is-master: Button {
                width: MixerStyle.btn-w(root.compact);
                height: MixerStyle.btn-h(root.compact);
                resting-bg: Theme.surface-high;
                corner-radius: 2px;
                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 3px;
                drop-shadow-offset-x: 1.5px;

                text: "R";

                toggled: root.arm;
                toggled-bg: Theme.danger;

                clicked => {
                    root.param-changed(
                        root.channel-index,
                        "arm",
                        root.arm ? 0.0 : 1.0
                    );
                }
            }
        }

        // ======================================
        // INSERTS
        // ======================================

        SectionHeader {
            title: "INSERTS";
            expanded: root.show-inserts;
            toggled => { root.show-inserts = !root.show-inserts; }
        }

        if root.show-inserts: VerticalLayout {
            // MIDDLE FLEX: a única região elástica da faixa. `min-height:
            // 0` garante que ela cede espaço ANTES do bloco de fader/meter
            // quando o painel está baixo — sem isso o Slint esmagava o
            // bottom fixo e o meter sumia.
            min-height: 0px;
            preferred-width: 100%;
            spacing: MixerStyle.gap(root.compact);


            cross-axis-alignment: CrossAxisAlignment.center;
            horizontal-stretch: 0;

            vertical-stretch: 1;
            width: 100%;

            // Scrollable area for insert slots
            ScrollView {
                width: 100%;
                vertical-stretch: 1;

                VerticalLayout {
                    cross-axis-alignment: CrossAxisAlignment.center;
                    horizontal-stretch: 1;
                    spacing: MixerStyle.gap(root.compact);
                    width: 100%;

                    for j in [0, 1, 2, 3, 4, 5, 6, 7]: InsertSlot {
                        visible: j < root.insert-count;

                        slot-index: j;
                        compact: root.compact;

                        dragging: root.drag-from == j;
                        drop-target: root.drag-to == j && root.drag-to != root.drag-from;

                        name: root.insert-names[
                            root.channel-index * root.max-slot-count + j
                        ];

                        enabled: root.insert-enabled[
                            root.channel-index * root.max-slot-count + j
                        ];

                        toggle() => {
                            root.insert-toggle(j);
                        }

                        remove() => {
                            root.insert-remove(j);
                        }

                        drag-start(slot) => {
                            root.drag-from = slot;
                            root.drag-to = slot;
                        }

                        drag-move(slot, rows) => {
                            if (root.drag-from >= 0) {
                                root.drag-to = Math.max(
                                    0,
                                    Math.min(root.insert-count - 1, slot + rows)
                                );
                            }
                        }

                        drag-drop(slot, rows) => {
                            if (root.drag-from >= 0) {
                                // O destino é a linha onde o ponteiro soltou,
                                // não a posição visual do slot arrastado.
                                root.insert-move(
                                    root.drag-from,
                                    Math.max(0, Math.min(root.insert-count - 1, slot + rows))
                                );
                            }
                            root.drag-from = -1;
                            root.drag-to = -1;
                        }

                        rename(slot, nome) => {
                            root.insert-rename(slot, nome);
                        }
                    }
                }
            }

            // ADD INSERT (always visible at bottom)
            Button {
                text: "+";

                width: MixerStyle.btn-w(root.compact);
                height: MixerStyle.btn-h(root.compact);

                padding-x: 0px;
            

                preferred-width: 0px;
                // O descanso herdado (`surface`) era idêntico ao fundo
                // do canal — o "+" só aparecia quando o mouse passava
                // em cima. Alinhado com o repouso do M/S/R acima.
                resting-bg: Theme.surface-high;

                corner-radius: 3px;

                text-color: Theme.text-dim;

                clicked => {
                    root.insert-add();
                }
            }
        }

            // ======================================
        // PAN
        // ======================================

        SectionHeader {
            title: "PAN";
            expanded: root.show-pan;
            toggled => { root.show-pan = !root.show-pan; }
        }

        if root.show-pan: PanControl {
            horizontal-stretch: 1;
            compact: root.compact;
            value <=> root.pan;
            changed(v) => {
                root.param-changed(root.channel-index, "pan", v);
            }
        }

        

        // ======================================
        // FADER + METER + DB DISPLAY
        //
        // BOTTOM FIXO. `min-height` é o piso do bloco: mesmo com o
        // painel baixo, o Slint não pode esmagar fader/meter/dB — era
        // isso que fazia a parte de baixo da faixa "sumir" e só voltar
        // quando a janela crescia. 131px = meter 110 + dB 16 + spacing 5.
        // Quem cede espaço é a região de inserts (flex + scroll acima).
        // ======================================

        VerticalLayout {
            preferred-height: MixerStyle.fader-pref-h(root.compact);
            min-height: MixerStyle.fader-min-h(root.compact);
            spacing: MixerStyle.gap(root.compact);
            alignment: LayoutAlignment.start;
            cross-axis-alignment: CrossAxisAlignment.center;
            vertical-stretch: 0; // Explicitly prevent vertical stretching

        

            VerticalLayout {
                cross-axis-alignment: CrossAxisAlignment.center;
                height: 100%;

            // O medidor e o fader são o MESMO componente agora: o
            // triângulo vive sobre a própria barra. Tira exatamente a
            // duplicação que fazia o número do LCD e o desenho do
            // controle discordarem.
            Meter {
               
                horizontal-stretch: 0;
                vertical-stretch: 1; // Explicitly prevent vertical stretching

                // Sem isto a luz de clip devolveria o índice padrão (0)
                // e o clique no canal 5 apagaria o latch do canal 0.
                channel-index: root.channel-index;
                fader-color: root.channel-color;
                empty-meter-color: Theme.is-paper
                    ? Theme.surface.darker(0.2)
                    : Theme.surface.brighter(0.65);

                left-level: root.left-level;
                right-level: root.right-level;
                left-peak: root.left-peak;
                min-height: MixerStyle.meter-min-h(root.compact);
                right-peak: root.right-peak;
                left-rms: root.left-rms;
                right-rms: root.right-rms;
                left-clipped: root.left-clipped;
                right-clipped: root.right-clipped;

                volume <=> root.volume;

                volume-changed(v) => {
                    root.param-changed(root.channel-index, "volume", v);
                }

                clip-cleared(ch) => {
                    root.clear-clip(ch);
                }
            }

            // ==================================
            // DB DISPLAY
            // ==================================
            Rectangle {
                width: MixerStyle.db-box-w(root.compact);
                height: MixerStyle.btn-h(root.compact);
                vertical-stretch: 0; // Explicitly prevent vertical stretching

                background: Theme.base;

                border-radius: 3px;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 2px;
                    spacing: MixerStyle.gap(root.compact);
                    alignment: LayoutAlignment.center;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    width: 100%;
                    height: 100%;

                    db-value-input := TextInput {
                        text: root.vol-display;
                        // Decimal aceita sinal negativo e separador decimal.
                        input-type: decimal;
                        horizontal-stretch: 1;
                        height: 100%;
                        color: Theme.text-primary;
                        font-size: MixerStyle.value-size(root.compact);
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;

                        accepted => {
                            root.volume = AudioScale.db-to-fader-pos(self.text.to-float());
                            root.param-changed(root.channel-index, "volume", root.volume);
                            self.clear-focus();
                        }
                    }

                    Text {
                        text: "dB";
                        width: 12px;
                        height: 100%;
                        color: Theme.text-dim;
                        font-size: MixerStyle.label-size(root.compact);
                        vertical-alignment: center;
                    }
                }

                // A caixa inteira edita o valor. Isso também encaminha
                // cliques no sufixo dB ao campo sem selecionar o canal.
                TouchArea {

                    mouse-cursor: text;
                    clicked => {
                        db-value-input.focus();
                        db-value-input.select-all();
                    }
                    z: 10;
                }
            }
        }
        }
    }
}