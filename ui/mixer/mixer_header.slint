import { Theme } from "../theme.slint";
import { MixerStyle } from "mixer_style.slint";
import { Button } from "../components/button.slint";

export component MixerHeader inherits Rectangle {
    in-out property <bool> floating: false;
    in property <int> selected-channel: 0;
    callback float-toggle();
    callback copy-slots();
    callback paste-slots();
    callback undo();
    callback redo();

    /// Largura das faixas, editada pelos botões de estreitar/alargar.
    in-out property <length> channel-width: 100px;

    /// Densidade: compact em telas estreitas, wide em notebook+.
    in property <bool> compact: false;

    height: MixerStyle.header-h(root.compact);
    background: Theme.surface;

    HorizontalLayout {
        padding-left: MixerStyle.pad(root.compact);
        padding-right: MixerStyle.pad(root.compact);
        spacing: MixerStyle.gap(root.compact);
        cross-axis-alignment: CrossAxisAlignment.center;
        height: 100%;

        if !root.compact: Text {
            text: "Mixer";
            color: Theme.text-primary;
            font-size: MixerStyle.label-size(root.compact);
            font-weight: 600;
        }

        if !root.compact: Rectangle { width: 1px; height: 16px; background: Theme.border; }

        if !root.compact: Button {
            text: "Copiar slots";
            height: MixerStyle.btn-h(root.compact);
            padding-x: MixerStyle.pad(root.compact);
            corner-radius: 3px;
            resting-bg: Theme.surface-high;
            clicked => { root.copy-slots(); }
        }
        if !root.compact: Button {
            text: "Colar";
            height: MixerStyle.btn-h(root.compact);
            padding-x: MixerStyle.pad(root.compact);
            corner-radius: 3px;
            resting-bg: Theme.surface-high;
            clicked => { root.paste-slots(); }
        }
        if !root.compact: Button {
            width: MixerStyle.btn-w(root.compact);
            height: MixerStyle.btn-h(root.compact);
            icon: @image-url("../icons/undo.svg");
            icon-size: 11px;
            borderless: true;
            clicked => { root.undo(); }
        }
        if !root.compact: Button {
            width: MixerStyle.btn-w(root.compact);
            height: MixerStyle.btn-h(root.compact);
            icon: @image-url("../icons/redo.svg");
            icon-size: 11px;
            borderless: true;
            clicked => { root.redo(); }
        }

        Rectangle { horizontal-stretch: 1; }

        // Largura das faixas: 14px por clique, dentro de 72..148.
        Button {
            width: MixerStyle.btn-w(root.compact);
            height: MixerStyle.btn-h(root.compact);
            text: "−";
            padding-x: 0px;
            corner-radius: 3px;
            resting-bg: Theme.surface-high;
            enabled: root.channel-width > 72px;
            clicked => {
                root.channel-width = max(72px, root.channel-width - 14px);
            }
        }
        Button {
            width: MixerStyle.btn-w(root.compact);
            height: MixerStyle.btn-h(root.compact);
            text: "+";
            padding-x: 0px;
            corner-radius: 3px;
            resting-bg: Theme.surface-high;
            enabled: root.channel-width < 148px;
            clicked => {
                root.channel-width = min(148px, root.channel-width + 14px);
            }
        }

        Button {
            width: MixerStyle.btn-w(root.compact);
            height: MixerStyle.btn-h(root.compact);
            icon: @image-url("../icons/expand_diag.svg");
            icon-size: MixerStyle.label-size(root.compact);
            borderless: true;
            icon-color: Theme.text-dim;
            transform-rotation: root.floating ? 180deg : 0deg;
            toggled: root.floating;
            toggled-icon-color: Theme.accent;
            clicked => { root.float-toggle(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}
